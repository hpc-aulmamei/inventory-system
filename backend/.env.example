# Copy to .env and set your own passwords before starting.
ADMIN_PASSWORD=
ADMIN_CLEAR_CODE=
# DATABASE_URL=sqlite:///absolute/path/inventory.db
# UPLOAD_DIR=/absolute/path/uploads
# BACKUP_DIR=/absolute/path/backups

# Sessions are process-local. Run one backend worker; restart revokes sessions.
ADMIN_SESSION_TTL_SECONDS=43200
# Exact frontend origins, comma-separated. Never use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LAN testing is limited to private IPs on frontend port 5173.
CORS_ALLOW_LAN=true
# Docs contain API structure. Enable only for local development.
ENABLE_API_DOCS=false

# Optional LDAP login (for example FreeIPA). Disabled while LDAP_SERVER_URI is
# empty. Users sign in with their directory account; only members of
# LDAP_REQUIRED_GROUP_DN are admitted. ADMIN_PASSWORD stays available as a local
# fallback; leave it empty to allow LDAP login only.
LDAP_SERVER_URI=
# LDAP_SERVER_URI=ldaps://ldap.example.com
LDAP_USER_DN_TEMPLATE=uid={username},cn=users,cn=accounts,dc=example,dc=com
LDAP_REQUIRED_GROUP_DN=cn=inventory-admins,cn=groups,cn=accounts,dc=example,dc=com
# CA that signed the LDAP server certificate, if the system store lacks it
# (FreeIPA: /etc/ipa/ca.crt, or http://ipa.example/ipa/config/ca.crt).
LDAP_CA_CERT_FILE=
# Persoane → "Sincronizează din FreeIPA": every active directory account becomes
# a borrower; members of this group also become responsible for items. Leave
# empty to manage the responsible role by hand.
LDAP_RESPONSIBLE_GROUP_DN=
# Only for ldap:// URIs. Plain ldap:// without StartTLS is refused.
LDAP_START_TLS=false
LDAP_TIMEOUT_SECONDS=5

# Optional SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
